+func TestConstructConftestPullCommand_WithHTTPPrefix(t *testing.T) {
+	name, args := constructConftestPullCommand(
+		"http://localhost:5050/rosa-seaplane-compliance/opa-bundles/rosa-seaplane:v0.1.0",
+		"/tmp/policy",
+	)
+	assert.Equal(t, "conftest", name)
+	assert.Contains(t, args, "oci://localhost:5050/rosa-seaplane-compliance/opa-bundles/rosa-seaplane:v0.1.0")
+	assert.Contains(t, args, "--tls=false")
+
+	for _, arg := range args {
+		assert.NotContains(t, arg, "http://",
+			"scheme should be stripped from the oci:// reference")
+	}
+}
+
+func TestConstructConftestPullCommand_WithoutHTTPPrefix(t *testing.T) {
+	_, args := constructConftestPullCommand(
+		"ghcr.io/org/bundle:dev", "/tmp/policy",
+	)
+	assert.NotContains(t, args, "--tls=false",
+		"TLS must stay on by default when no http:// prefix is given")
+}
