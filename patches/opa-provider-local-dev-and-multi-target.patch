+// constructConftestPullCommand builds the conftest pull invocation for
+// bundleRef. An "http://" prefix on bundleRef opts into plain-HTTP (TLS
+// disabled) access to the registry, mirroring the same convention complyctl
+// uses for policy source URLs (internal/registry/client.go NewClient); the
+// scheme is stripped before the oci:// reference is constructed, since
+// oci:// references don't carry a transport scheme themselves.
 func constructConftestPullCommand(bundleRef, policyDir string) (string, []string) {
-	return "conftest", []string{
+	ref := strings.TrimPrefix(bundleRef, "oci://")
+	plainHTTP := strings.HasPrefix(ref, "http://")
+	ref = strings.TrimPrefix(ref, "http://")
+	ref = strings.TrimPrefix(ref, "https://")
+
+	args := []string{
 		"pull",
-		"oci://" + strings.TrimPrefix(bundleRef, "oci://"),
+		"oci://" + ref,
 		"--policy", policyDir,
 	}
+	if plainHTTP {
+		args = append(args, "--tls=false")
+	}
+	return "conftest", args
 }
 
